{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "python": ["{projectRoot}/src/**/*", "{projectRoot}/pyproject.toml", "{projectRoot}/uv.lock"],
    "tests": ["{projectRoot}/tests/**/*"],
    "analysis": ["{projectRoot}/analysis/**/*"],
    "inputs": ["{projectRoot}/data/reference/**/*", "{projectRoot}/data/assumptions/**/*"]
  },
  "targetDefaults": {
    "lint": {
      "cache": true,
      "inputs": ["python", "tests", "analysis", "{projectRoot}/.pre-commit-config.yaml"]
    },
    "test": {
      "cache": true,
      "inputs": ["python", "tests", "inputs"]
    }
  }
}
