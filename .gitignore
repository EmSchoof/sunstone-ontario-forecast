.DS_Store

# --- Secrets (API keys) -------------------------------------------------
.env
.env.*
# **/ so keys are ignored wherever dlt runs (it reads .dlt/ in ontario_model/)
**/.dlt/secrets.toml
**/.dlt/*.secrets.toml

# --- dlt state ----------------------------------------------------------
.dlt_pipelines/

# --- Generated data (rebuildable from the pipeline) ---------------------
data/raw/
data/warehouse/
*.duckdb
*.duckdb.wal
*.csv.gz
*.parquet

# --- Generated exploratory output -----------------------------------------
outputs/eda/

# Tracked on purpose:
#   data/*.csv          all input data: cited reference figures + impact-model inputs (docs/02_methods.md A6)
#   outputs/charts/     deliverable charts (PNG, SVG, PDF)
#   outputs/tables/     every charted number as CSV
#   outputs/models/     fitted model coefficients (small, reviewable)
#   outputs/docs/       shareable PDFs of docs/*.md
# Every source is registered in docs/04_sources.md; outputs/tables/source_snapshot.csv records
# what the (untracked) raw downloads contained when the outputs were built.
